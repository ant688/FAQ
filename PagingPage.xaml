<Page x:Class="PDFWand.Views.Pages.PagingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PDFWand.Views.Pages"
      xmlns:models="clr-namespace:PDFWand.Models"
      xmlns:helpers="clr-namespace:PDFWand.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
      d:DataContext="{d:DesignInstance local:PagingPage,
                                     IsDesignTimeCreatable=False}"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PagingPage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <ui:Button Command="{Binding ViewModel.OpenFileCommand}"
                       Icon="{ui:SymbolIcon Symbol=Document24, FontSize=18}"
                Content="{i18n:StringLocalizer 'SelectFile'}"/>
            <ui:TextBlock Grid.Row="1" TextWrapping="WrapWithOverflow"
                          Margin="0 5 0 0"
                          Text="{Binding ViewModel.SelectPath}"
                          Visibility="{Binding ViewModel.OpenedFilePathVisibility}"/>
            <ui:TextBlock FontTypography="BodyStrong" Margin="0 5 0 0" Grid.Row="2" Text="{i18n:StringLocalizer 'PagingPosition'}"/>
            <Grid Grid.Row="3" Margin="0 5 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding ViewModel.IsTopLeft,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingTopLeft'}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding ViewModel.IsTopCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingTopCenter'}"/>
                <CheckBox Grid.Column="2" IsChecked="{Binding ViewModel.IsTopRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingTopRight'}"/>
                <CheckBox Grid.Row="1" IsChecked="{Binding ViewModel.IsBottomLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingBottomLeft'}"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ViewModel.IsBottomCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingBottomCenter'}"/>
                <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding ViewModel.IsBottomRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{i18n:StringLocalizer 'PagingBottomRight'}"/>
            </Grid>
            <ui:TextBlock  Grid.Row="4" FontTypography="BodyStrong" Margin="0 5 0 0" Text="{i18n:StringLocalizer 'PagingText'}"/>
            <ui:TextBox Grid.Row="5" Margin="0 0 10 0" PlaceholderText="{Binding ViewModel.DefaultPagingContent}"
                        Text="{Binding ViewModel.PagingContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:TextBlock Grid.Row="6" FontTypography="BodyStrong" Margin="0 5 0 0"  Text="{i18n:StringLocalizer 'PagingFont'}"/>
            <ComboBox Grid.Row="7"
                      ItemsSource="{Binding ViewModel.ListFont}"
                      SelectedItem="{Binding ViewModel.SelectedFont}"
                      Margin="0 0 10 0"/>
            <Grid Grid.Row="8" Margin="0 5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{i18n:StringLocalizer 'PagingFontSize'}"/>
                    <ui:NumberBox Minimum="1" Maximum="100" Value="{Binding ViewModel.FontSize}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10 0 0 0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{i18n:StringLocalizer 'PagingFontColor'}"/>
                    <ui:SplitButton Icon="{ui:SymbolIcon PaintBrush24}">
                        <Border x:Name="FontColorBorder"
                            Width="35"
                            Height="20"
                            Background="{Binding ViewModel.PreviewFontBrush}"
                            CornerRadius="4" />
                        <ui:SplitButton.Flyout>
                            <ContextMenu>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorBlack'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                                Width="35"
                                                Height="20"
                                                Background="Black"

                                                CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorRed'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Red"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorBlue'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Blue"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorWhite'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="White"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                    CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorGreen'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Green"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorYellow'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Yellow"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorOrange'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Orange"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorPurple'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Purple"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem AutomationProperties.Name="{i18n:StringLocalizer 'ColorGray'}"
                                          Click="MenuItem_Click">
                                    <MenuItem.Header>
                                        <Border
                                            Width="35"
                                            Height="20"
                                            Background="Gray"
                                            CornerRadius="4" />
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </ui:SplitButton.Flyout>
                    </ui:SplitButton>
                </StackPanel>
            </Grid>
            <ui:Button Grid.Row="9" Margin="0 10 0 0"
                       Command="{Binding ViewModel.AddPagingCommand}"
                       Icon="{ui:SymbolIcon Symbol=Save24, FontSize=18}"
                       Content="{i18n:StringLocalizer 'AddPaging'}"/>
        </Grid>
        <Grid Grid.Column="1" Visibility="{Binding ViewModel.HasSelectedFile, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" Margin="0 0 0 5" Visibility="{Binding ViewModel.PreviewOnePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Resources>
                    <helpers:PageDisplayConverter x:Key="PageDisplayConverter"/>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ui:Button Icon="{ui:SymbolIcon Symbol=Previous24}"
             Height="35"
             Command="{Binding ViewModel.PrevPageCommand}"/>
                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=Next24}"
             Height="35" Margin="5 0 0 0"
             Command="{Binding ViewModel.NextPageCommand}"/>
                <ui:TextBox Grid.Column="2" Margin="5 0"
              ClearButtonEnabled="False"
              Text="{Binding ViewModel.CurrentPageIndex, Converter={StaticResource PageDisplayConverter}}"
              Width="50"/>
                <ui:TextBlock Grid.Column="3" Text="{Binding ViewModel.TotalPage, StringFormat='/ {0}'}" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="4" Margin="5 0 0 0"
                           Content="{i18n:StringLocalizer 'ZoomOut'}"
                           Command="{Binding ViewModel.ZoomOutCommand}"/>
                <ui:TextBlock Grid.Column="5" Margin="5 0" VerticalAlignment="Center"
                              Text="{Binding ViewModel.ZoomLevel, StringFormat='{}{0:P0}'}"/>
                <ui:Button Grid.Column="6" Margin="5 0 0 0"
                           Content="{i18n:StringLocalizer 'ZoomIn'}"
                           Command="{Binding ViewModel.ZoomInCommand}"/>
                <ui:Button Grid.Column="7" Margin="5 0 0 0"
                           Content="{i18n:StringLocalizer 'PagingFitToScreen'}"
                           Command="{Binding ViewModel.FitToScreenCommand}"/>

            </Grid>
            <ui:Card Grid.Row="2" VerticalAlignment="Top" Visibility="{Binding ViewModel.PreviewOnePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewScrollViewer_SizeChanged">
                    <Grid>
                        <ui:Image Source="{Binding ViewModel.CurrentViewPage}" RenderTransformOrigin="0.5,0.5">
                            <ui:Image.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ViewModel.ZoomLevel}" ScaleY="{Binding ViewModel.ZoomLevel}"/>
                            </ui:Image.LayoutTransform>
                        </ui:Image>
                        <Grid IsHitTestVisible="False">
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="16"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Visibility="{Binding ViewModel.IsTopLeft, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="0,16,0,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          TextAlignment="Center"
                                          Visibility="{Binding ViewModel.IsTopCenter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="0,16,16,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          TextAlignment="Right"
                                          Visibility="{Binding ViewModel.IsTopRight, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="16,0,0,16"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom"
                                          Visibility="{Binding ViewModel.IsBottomLeft, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="0,0,0,16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          TextAlignment="Center"
                                          Visibility="{Binding ViewModel.IsBottomCenter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text="{Binding ViewModel.PreviewPagingText}"
                                          FontSize="{Binding ViewModel.FontSize}"
                                          Foreground="{Binding ViewModel.PreviewFontBrush}"
                                          Margin="0,0,16,16"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          TextAlignment="Right"
                                          Visibility="{Binding ViewModel.IsBottomRight, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </ui:Card>
            <ui:VirtualizingItemsControl Grid.Row="2" Visibility="{Binding ViewModel.PreviewAllPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  ItemsSource="{Binding ViewModel.PreviewPages, Mode=OneWay}"
                  VirtualizingPanel.CacheLengthUnit="Item">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PdfPreviewPage}">
                        <StackPanel>
                            <ui:Image Source="{Binding ViewPage}" BorderThickness="1" BorderBrush="Black"/>
                            <StackPanel Orientation="Horizontal" Margin="0 5">
                                <ui:TextBlock Text="{Binding PageNo, StringFormat='Page {0}/'}" HorizontalAlignment="Center"/>
                                <ui:TextBlock Text="{Binding TotalPage}"/>
                            </StackPanel>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ui:VirtualizingItemsControl>
        </Grid>
    </Grid>
</Page>
